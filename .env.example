# VELUNE environment template
#
# This project does not read .env automatically. Either export the variables in
# your shell, or start the server with:
#
#   node --env-file=.env server.js          (npm run start:env)
#
# Never commit a filled-in copy of this file.

# ---------------------------------------------------------------- core server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# NODE_ENV=production enables HSTS and Secure cookies; use it on the live site.
# Public origin used in canonical tags, emails and same-origin checks.
# Set this before exposing the site, and serve it over HTTPS.
SITE_URL=https://your-domain.example
# Set to true only when a trusted proxy (Railway, Fly, nginx) adds
# X-Forwarded-For. Then rate limits key on the real visitor, not the proxy.
TRUST_PROXY=false

# Long random values. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=
# Customer session HMAC key. When unset, a random key is generated once and
# stored in SQLite so sessions survive restarts; set it in production.
SESSION_SECRET=

# ---------------------------------------------------------------- persistent storage
# Runtime state (SQLite database, private KYC documents, avatars, the fallback
# integration key and uploaded product images) must live on a mounted volume.
# On Railway: create one volume mounted at /data, then set:
#   DATA_DIR=/data
#   UPLOADS_DIR=/data/uploads
# Leaving these blank stores everything under ./data and ./public/images/uploads,
# which is wiped on redeploy.
# DATA_DIR=/data
# UPLOADS_DIR=/data/uploads
# Optional exact database path (default: $DATA_DIR/velune.db).
# STORE_DB_PATH=/data/velune.db

# ---------------------------------------------------------------- admin account
# Preferred: a scrypt$salt$hash string, produced by the server or a password tool.
# ADMIN_PASSWORD_HASH=
# Plain-text fallback, compared in constant time and never stored. The server
# generates a one-time password on a brand-new database if neither is set.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# ---------------------------------------------------------------- catalogue
# Defaults used when a product is created without explicit cost/profit.
DEFAULT_BASE_COST=46
DEFAULT_PROFIT=6

# ---------------------------------------------------------------- email OTP (SMTP)
# Enable only after SMTP_HOST is reachable from the server.
OTP_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# Set to true for implicit TLS on port 465.
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="VELUNE <no-reply@your-domain.example>"
SMTP_EHLO_HOST=

# ---------------------------------------------------------------- SMS OTP
# provider: twilio | msg91 | (blank with SMS_WEBHOOK_URL for a custom gateway)
OTP_SMS_ENABLED=false
SMS_PROVIDER=
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MSG91_AUTH_KEY=
MSG91_ROUTE=ENGLISH
# Custom gateway: receives POST { to, message, template }.
SMS_WEBHOOK_URL=

# Enforce email/mobile verification and private /reseller access even when no
# live OTP provider is configured. Codes then appear in Admin -> Delivery for
# manual relay, and OTP_DEV_ECHO=true also returns the code to the API response.
# Leave both false until a provider is live.
OTP_ENFORCE=false
OTP_DEV_ECHO=false

# ---------------------------------------------------------------- integrations
# AES-256-GCM key material for Shopify / WooCommerce / supplier credentials.
# When unset, a 32-byte key file is created at data/private/integrations.key.
# Set this in production and back it up separately from the database.
INTEGRATIONS_SECRET=

# ---------------------------------------------------------------- testing only
# Never set this in production.
# RATE_LIMIT_DISABLED=true
